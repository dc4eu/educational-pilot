# =============================================================================
# SHACL Shape: European Digital Credential – Generic Application Profile
# Profile:     EuropeanDigitalCredential (EDC generic, no controlled vocabularies)
# Version:     1.0.0
# Date:        2026-03-01
# Source:      https://europa.eu/europass/elm-browser/documentation/rdf/ap/edc/
#              documentation/edc-generic-no-cv.html  (v1.1.0, 2023-06-05)
# Base schema: https://api-pilot.ebsi.eu/trusted-schemas-registry/v3/schemas/
#              0xe9d256a96313a24d5884d56f0835047febc0ebf46fbdd20c906f49057a1e0f02
# Licence:     CC BY 4.0
#
# Purpose:
#   This file translates the human-readable EDC Application Profile SHACL
#   documentation into machine-executable Turtle shapes, aligned with
#   W3C-VC Data Model 2.0 and eIDAS 2.0.
#
#   It covers all classes defined in the EDC AP:
#     Accreditation, Address, Agent, Amount, AwardingOpportunity,
#     AwardingProcess, Claim, ClaimTypeNode, Concept, ConceptScheme,
#     ContactPoint, CreditPoint, DisplayDetail, DisplayParameter,
#     EuropeanDigitalCredential, EuropeanDigitalPresentation, Evidence,
#     Geometry, GradingScheme, Grant, Group, Identifier, IndividualDisplay,
#     IssuerNode, LearningAchievement, LearningAchievementSpecification,
#     LearningActivity, LearningActivitySpecification, LearningAssessment,
#     LearningAssessmentSpecification, LearningEntitlement,
#     LearningEntitlementSpecification, LearningOpportunity, LearningOutcome,
#     LegalIdentifier, Location, Mailbox, MediaObject, Note, Organisation,
#     PeriodOfTime, Person, Phone, PriceDetail, Qualification,
#     ResultCategory, ResultDistribution, ShaclValidator2017,
#     ShortenedGrading, Specification, VerifiableCredential,
#     VerifiablePresentation, VerificationCheck, WebResource.
#
#   Profile-specific constraints (ECTS/ECVET, provenBy mandatory, etc.)
#   are intentionally absent. They belong to the profile-level shapes
#   (he-micro, vet-micro, he-diploma, upper-sec).
#
# Relationship to profile shapes:
#   Profile shapes extend this generic shape via sh:node references.
#   This generic shape is the level-2 layer; profile shapes are level-3.
# =============================================================================

@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix elm:   <http://data.europa.eu/snb/model/elm/> .
@prefix cred:  <https://www.w3.org/2018/credentials#> .
@prefix dc:    <http://purl.org/dc/terms/> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix adms:  <http://www.w3.org/ns/adms#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix locn:  <http://www.w3.org/ns/locn#> .
@prefix org:   <http://www.w3.org/ns/org#> .
@prefix rov:   <http://www.w3.org/ns/regorg#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix cpv:   <http://www.w3.org/ns/person#> .
@prefix clv:   <http://data.europa.eu/m8g/> .
@prefix edc:   <https://api-pilot.ebsi.eu/trusted-schemas-registry/v3/shacl/edc-generic#> .


# =============================================================================
# EUROPEAN DIGITAL CREDENTIAL
# Applies to: elm:EuropeanDigitalCredential
# =============================================================================

edc:EuropeanDigitalCredentialShape
    a sh:NodeShape ;
    sh:targetClass elm:EuropeanDigitalCredential ;
    sh:name "European Digital Credential"@en ;

    sh:property [
        sh:path     elm:credentialProfiles ;
        sh:minCount 1 ;
        sh:node     edc:ConceptShape ;
        sh:severity sh:Violation ;
        sh:message  "elm:credentialProfiles is mandatory (1..*) and must be a Concept."@en ;
    ] ;
    sh:property [
        sh:path     cred:credentialSchema ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message  "cred:credentialSchema is mandatory (1..*). At least one ShaclValidator2017 entry is required."@en ;
    ] ;
    sh:property [
        sh:path     elm:displayParameter ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node     edc:DisplayParameterShape ;
        sh:severity sh:Violation ;
        sh:message  "elm:displayParameter is mandatory (1..1)."@en ;
    ] ;
    sh:property [
        sh:path     cred:issuer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node     edc:IssuerNodeShape ;
        sh:severity sh:Violation ;
        sh:message  "cred:issuer is mandatory (1..1) and must conform to IssuerNodeShape."@en ;
    ] ;
    sh:property [
        sh:path     cred:credentialSubject ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message  "cred:credentialSubject is mandatory (1..1)."@en ;
    ] ;
    sh:property [
        sh:path     cred:issued ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:severity sh:Violation ;
        sh:message  "cred:issued is mandatory (1..1) and must be xsd:dateTime."@en ;
    ] ;
    sh:property [
        sh:path     cred:validFrom ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:severity sh:Violation ;
        sh:message  "cred:validFrom is mandatory (1..1) and must be xsd:dateTime."@en ;
    ] ;
    sh:property [
        sh:path     elm:attachment ;
        sh:node     edc:MediaObjectShape ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path     cred:credentialStatus ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path     cred:validUntil ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path     adms:identifier ;
        sh:severity sh:Warning ;
    ] .


# =============================================================================
# ISSUER NODE
# Applies to: elm:IssuerNode (shape-only, no class target)
# An issuer must have exactly one eidasLegalIdentifier.
# =============================================================================

edc:IssuerNodeShape
    a sh:NodeShape ;
    sh:name "Issuer Node"@en ;
    sh:property [
        sh:path     elm:eidasLegalIdentifier ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node     edc:LegalIdentifierShape ;
        sh:severity sh:Violation ;
        sh:message  "elm:eidasLegalIdentifier is mandatory (1..1) on the issuer."@en ;
    ] .


# =============================================================================
# VERIFIABLE CREDENTIAL
# Applies to: cred:VerifiableCredential
# =============================================================================

edc:VerifiableCredentialShape
    a sh:NodeShape ;
    sh:targetClass cred:VerifiableCredential ;
    sh:name "Verifiable Credential"@en ;

    sh:property [
        sh:path     cred:credentialSchema ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message  "cred:credentialSchema is mandatory (1..*) and must be an IRI."@en ;
    ] ;
    sh:property [
        sh:path     cred:credentialSubject ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path     cred:issuer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node     edc:IssuerNodeShape ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path     cred:issued ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path     cred:validFrom ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:severity sh:Violation ;
    ] .


# =============================================================================
# PERSON
# Applies to: elm:Person
# =============================================================================

edc:PersonShape
    a sh:NodeShape ;
    sh:targetClass elm:Person ;
    sh:name "Person"@en ;

    sh:property [
        sh:path     elm:hasClaim ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message  "elm:hasClaim is mandatory (1..*) on Person."@en ;
    ] ;
    sh:property [
        sh:path     foaf:familyName ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path     foaf:givenName ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path     elm:dateOfBirth ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path     elm:nationalId ;
        sh:maxCount 1 ;
        sh:node     edc:LegalIdentifierShape ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path     elm:location ;
        sh:maxCount 1 ;
        sh:node     edc:LocationShape ;
        sh:severity sh:Warning ;
    ] .


# =============================================================================
# ORGANISATION
# Applies to: elm:Organisation
# =============================================================================

edc:OrganisationShape
    a sh:NodeShape ;
    sh:targetClass elm:Organisation ;
    sh:name "Organisation"@en ;

    sh:property [
        sh:path     rov:legalName ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message  "rov:legalName is mandatory (1..*) on Organisation."@en ;
    ] ;
    sh:property [
        sh:path     elm:location ;
        sh:minCount 1 ;
        sh:node     edc:LocationShape ;
        sh:severity sh:Violation ;
        sh:message  "elm:location is mandatory (1..*) on Organisation."@en ;
    ] ;
    sh:property [
        sh:path     elm:eidasLegalIdentifier ;
        sh:maxCount 1 ;
        sh:node     edc:LegalIdentifierShape ;
        sh:severity sh:Warning ;
        sh:message  "elm:eidasLegalIdentifier is recommended (0..1) on Organisation."@en ;
    ] ;
    sh:property [
        sh:path     rov:registration ;
        sh:maxCount 1 ;
        sh:node     edc:LegalIdentifierShape ;
        sh:severity sh:Warning ;
    ] .


# =============================================================================
# CLAIM
# Applies to: elm:Claim
# Common properties for all claim subclasses.
# =============================================================================

edc:ClaimShape
    a sh:NodeShape ;
    sh:targetClass elm:Claim ;
    sh:name "Claim"@en ;

    sh:property [
        sh:path     dc:title ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message  "dc:title is mandatory (1..*) on Claim."@en ;
    ] ;
    sh:property [
        sh:path     elm:awardedBy ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node     edc:AwardingProcessShape ;
        sh:severity sh:Violation ;
        sh:message  "elm:awardedBy is mandatory (1..1) on Claim."@en ;
    ] .


# =============================================================================
# LEARNING ACHIEVEMENT
# Applies to: elm:LearningAchievement
