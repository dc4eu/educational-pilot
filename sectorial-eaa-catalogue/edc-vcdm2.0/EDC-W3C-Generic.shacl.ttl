    sh:property [
        sh:path     dc:title ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message  "dc:title is mandatory (1..*) on LearningAchievement."@en ;
    ] ;
    sh:property [
        sh:path     elm:awardedBy ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node     edc:AwardingProcessShape ;
        sh:severity sh:Violation ;
        sh:message  "elm:awardedBy is mandatory (1..1) on LearningAchievement."@en ;
    ] ;
    sh:property [
        sh:path     elm:specifiedBy ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path     elm:provenBy ;
        sh:node     edc:LearningAssessmentShape ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path     elm:creditReceived ;
        sh:node     edc:CreditPointShape ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path     elm:entitlesTo ;
        sh:node     edc:LearningEntitlementShape ;
        sh:severity sh:Warning ;
    ] .


