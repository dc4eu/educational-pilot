{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "European VET Microcredential (dual-schema v2)",
  "description": "Extends the original VET Microcredential JSON Schema (0x690878...) with a mandatory dual credentialSchema: JsonSchema + ShaclValidator2017. All credential logic is unchanged; only credentialSchema gains a structural constraint enforcing both validation layers.",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://api-pilot.ebsi.eu/trusted-schemas-registry/v3/schemas/0x690878adbdbc2c6b2865829003a1e34800df5d173d302ff11958836f8f977a26"
    },
    {
      "type": "object",
      "required": [
        "credentialSchema"
      ],
      "properties": {
        "credentialSchema": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "id",
              "type"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uri"
              },
              "type": {
                "type": "string",
                "enum": [
                  "JsonSchema",
                  "ShaclValidator2017"
                ]
              }
            },
            "additionalProperties": false
          },
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "https://api-pilot.ebsi.eu/trusted-schemas-registry/v3/schemas/0x690878adbdbc2c6b2865829003a1e34800df5d173d302ff11958836f8f977a26"
              },
              "type": {
                "const": "JsonSchema"
              }
            },
            "required": [
              "id",
              "type"
            ]
          },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "properties": {
                  "id": {
                    "const": "https://api-pilot.ebsi.eu/trusted-schemas-registry/v3/schemas/PENDING_TSR_REGISTRATION_VET_MICRO"
                  },
                  "type": {
                    "const": "ShaclValidator2017"
                  }
                },
                "required": [
                  "id",
                  "type"
                ]
              }
            }
          ]
        }
      }
    }
  ]
}