# =============================================================================
# SHACL Shape: European Vocational Education and Training Microcredential
# Profile:     EuropeanVocationalEducationTrainingMicrocredential
# Version:     1.0.0
# Date:        2026-03-01
# Base schema: https://api-pilot.ebsi.eu/trusted-schemas-registry/v3/schemas/
#              0x690878adbdbc2c6b2865829003a1e34800df5d173d302ff11958836f8f977a26
# EDC AP ref:  https://europa.eu/europass/elm-browser/documentation/rdf/ap/edc/
#              documentation/edc-generic-no-cv.html
# Licence:     CC BY 4.0
#
# Relationship to HE Microcredential SHACL shape:
#   Structurally identical. Two precise differences:
#   1. Profile type: EuropeanVocationalEducationTrainingMicrocredential
#   2. Credit framework: ECVET instead of ECTS
#   All other shapes (Issuer, LegalIdentifier, CredentialSubject,
#   LearningAchievement, Specification, EQF, AwardingProcess,
#   LearningAssessment) follow the same logic and severities.
# =============================================================================

@prefix sh:        <http://www.w3.org/ns/shacl#> .
@prefix elm:       <http://data.europa.eu/snb/model/elm/> .
@prefix cred:      <https://www.w3.org/2018/credentials#> .
@prefix dc:        <http://purl.org/dc/terms/> .
@prefix skos:      <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:       <http://www.w3.org/2001/XMLSchema#> .
@prefix rov:       <http://www.w3.org/ns/regorg#> .
@prefix rdf:       <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix vet-micro: <https://api-pilot.ebsi.eu/trusted-schemas-registry/v3/shacl/vet-micro#> .


# =============================================================================
# ROOT SHAPE
# =============================================================================

vet-micro:CredentialShape
    a sh:NodeShape ;
    sh:targetClass elm:EuropeanDigitalCredential ;
    sh:name "European VET Microcredential – SHACL Profile"@en ;
    sh:description
        "Level-3 semantic constraints for EuropeanVocationalEducationTrainingMicrocredential  credentials issued under ELM 3.2 / W3C-VC 2.0 / eIDAS 2.0.  Complements the JSON Schema registered at EBSI TSR  0x690878adbdbc2c6b2865829003a1e34800df5d173d302ff11958836f8f977a26."@en ;

    # -- Profile type (DIFFERENCE 1 vs HE Microcredential) --------------------
    sh:property [
        sh:path     rdf:type ;
        sh:hasValue elm:EuropeanVocationalEducationTrainingMicrocredential ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message
            "Credential must declare  elm:EuropeanVocationalEducationTrainingMicrocredential."@en ;
    ] ;

    # -- Dual credentialSchema ------------------------------------------------
    sh:property [
        sh:path     cred:credentialSchema ;
        sh:minCount 2 ;
        sh:severity sh:Violation ;
        sh:message
            "credentialSchema must contain at least two entries:  one of type JsonSchema and one of type ShaclValidator2017."@en ;
    ] ;

    # -- Issuer ---------------------------------------------------------------
    sh:property [
        sh:path     cred:issuer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node     vet-micro:IssuerShape ;
        sh:severity sh:Violation ;
        sh:message  "Credential must have exactly one issuer conforming to IssuerShape."@en ;
    ] ;

    # -- Credential subject ---------------------------------------------------
    sh:property [
        sh:path     cred:credentialSubject ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node     vet-micro:CredentialSubjectShape ;
        sh:severity sh:Violation ;
        sh:message
            "Credential must have exactly one credentialSubject  conforming to CredentialSubjectShape."@en ;
    ] .


# =============================================================================
# ISSUER SHAPE
# Identical logic to HE Microcredential.
# =============================================================================

vet-micro:IssuerShape
    a sh:NodeShape ;
    sh:property [
        sh:path     elm:eidasLegalIdentifier ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node     vet-micro:LegalIdentifierShape ;
        sh:severity sh:Violation ;
        sh:message  "Issuer must have exactly one eidasLegalIdentifier."@en ;
    ] .

vet-micro:LegalIdentifierShape
    a sh:NodeShape ;
    sh:property [
        sh:path     skos:notation ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation ;
        sh:message  "eidasLegalIdentifier must carry a skos:notation value."@en ;
    ] ;
    sh:property [
        sh:path     dc:spatial ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message
            "Jurisdiction (dc:spatial) must be an IRI,  preferably from the EU Publications Office country vocabulary."@en ;
    ] .


# =============================================================================
# CREDENTIAL SUBJECT SHAPE
# Identical logic to HE Microcredential.
# =============================================================================

vet-micro:CredentialSubjectShape
    a sh:NodeShape ;
    sh:property [
        sh:path     elm:dateOfBirth ;
        sh:minCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:severity sh:Violation ;
        sh:message  "credentialSubject must include elm:dateOfBirth."@en ;
    ] ;
    sh:property [
        sh:path     elm:hasClaim ;
        sh:minCount 1 ;
        sh:node     vet-micro:LearningAchievementShape ;
        sh:severity sh:Violation ;
        sh:message  "credentialSubject must have at least one LearningAchievement."@en ;
    ] .


# =============================================================================
# LEARNING ACHIEVEMENT SHAPE
# provenBy is MANDATORY, same as HE Microcredential.
# creditReceived uses ECVET shape (DIFFERENCE 2).
# =============================================================================

vet-micro:LearningAchievementShape
    a sh:NodeShape ;

    sh:property [
        sh:path     rdf:type ;
        sh:hasValue elm:LearningAchievement ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message  "hasClaim node must be of type elm:LearningAchievement."@en ;
    ] ;

    sh:property [
        sh:path     elm:specifiedBy ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node     vet-micro:SpecificationShape ;
        sh:severity sh:Violation ;
        sh:message
            "LearningAchievement must be specified by exactly one  LearningAchievementSpecification (elm:specifiedBy)."@en ;
    ] ;

    sh:property [
        sh:path     elm:awardedBy ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node     vet-micro:AwardingProcessShape ;
        sh:severity sh:Violation ;
        sh:message  "LearningAchievement must have exactly one elm:awardedBy."@en ;
    ] ;

    # -- provenBy MANDATORY (same as HE Microcredential) ----------------------
    sh:property [
        sh:path     elm:provenBy ;
        sh:minCount 1 ;
        sh:node     vet-micro:LearningAssessmentShape ;
        sh:severity sh:Violation ;
        sh:message
            "A VET microcredential must include at least one assessment  (elm:provenBy). This is the key differentiator from a diploma."@en ;
    ] ;

    # -- creditReceived: ECVET (DIFFERENCE 2 vs HE Microcredential) -----------
    sh:property [
        sh:path     elm:creditReceived ;
        sh:node     vet-micro:ECVETCreditShape ;
        sh:severity sh:Warning ;
        sh:message  "Declared credits should follow the ECVET framework (1–15 points)."@en ;
    ] .


# =============================================================================
# SPECIFICATION SHAPE
# Identical logic to HE Microcredential.
# creditPoint uses ECVET shape.
# =============================================================================

vet-micro:SpecificationShape
    a sh:NodeShape ;

    sh:property [
        sh:path     elm:EQFLevel ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node     vet-micro:EQFConceptShape ;
        sh:severity sh:Violation ;
        sh:message  "Specification must declare exactly one elm:EQFLevel."@en ;
    ] ;

    sh:property [
        sh:path     elm:educationSubject ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message  "Specification must include at least one elm:educationSubject."@en ;
    ] ;

    sh:property [
        sh:path     elm:mode ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message  "Specification must include at least one elm:mode."@en ;
    ] ;

    sh:property [
        sh:path     elm:creditPoint ;
        sh:minCount 1 ;
        sh:node     vet-micro:ECVETCreditShape ;
        sh:severity sh:Warning ;
        sh:message
            "It is recommended to declare ECVET credit points on the specification  (elm:creditPoint)."@en ;
    ] .


# =============================================================================
# EQF CONCEPT SHAPE
# Identical to HE Microcredential.
# =============================================================================

vet-micro:EQFConceptShape
    a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:pattern  "^http://data\\.europa\\.eu/snb/eqf/" ;
    sh:severity sh:Warning ;
    sh:message
        "EQF level should reference the EU Publications Office EQF vocabulary  (http://data.europa.eu/snb/eqf/)."@en ;
    sh:property [
        sh:path     skos:notation ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern  "^[1-8]$" ;
        sh:severity sh:Violation ;
        sh:message  "EQF level notation must be a single digit between 1 and 8."@en ;
    ] .


# =============================================================================
# ECVET CREDIT SHAPE  ← DIFFERENCE 2 vs HE Microcredential
# Framework notation must be "ECVET" instead of "ECTS".
# Point range is identical: 1–15.
# =============================================================================

vet-micro:ECVETCreditShape
    a sh:NodeShape ;
    sh:property [
        sh:path     elm:framework ;
        sh:minCount 1 ;
        sh:node     vet-micro:ECVETFrameworkShape ;
        sh:severity sh:Violation ;
        sh:message  "Credit framework must be ECVET in VET credentials."@en ;
    ] ;
    sh:property [
        sh:path     elm:point ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern  "^(1[0-5]|[1-9])$" ;
        sh:severity sh:Violation ;
        sh:message  "ECVET credit points must be a whole number between 1 and 15."@en ;
    ] .

vet-micro:ECVETFrameworkShape
    a sh:NodeShape ;
    sh:property [
        sh:path     skos:notation ;
        sh:hasValue "ECVET" ;
        sh:severity sh:Violation ;
        sh:message  "elm:framework notation must be exactly 'ECVET'."@en ;
    ] .


# =============================================================================
# AWARDING PROCESS SHAPE
# Identical logic to HE Microcredential.
# =============================================================================

vet-micro:AwardingProcessShape
    a sh:NodeShape ;
    sh:property [
        sh:path     elm:awardingBody ;
        sh:minCount 1 ;
        sh:node     vet-micro:AwardingBodyShape ;
        sh:severity sh:Violation ;
        sh:message  "AwardingProcess must include at least one elm:awardingBody."@en ;
    ] ;
    sh:property [
        sh:path     elm:awardingDate ;
        sh:minCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:severity sh:Violation ;
        sh:message  "AwardingProcess must include elm:awardingDate."@en ;
    ] ;
    sh:property [
        sh:path     elm:location ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message  "AwardingProcess must include elm:location."@en ;
    ] .

vet-micro:AwardingBodyShape
    a sh:NodeShape ;
    sh:property [
        sh:path     rov:legalName ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message
            "It is recommended to include the legal name of the awarding body  (rov:legalName)."@en ;
    ] .


# =============================================================================
# LEARNING ASSESSMENT SHAPE
# Identical logic to HE Microcredential.
# =============================================================================

vet-micro:LearningAssessmentShape
    a sh:NodeShape ;
    sh:property [
        sh:path     elm:grade ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message  "LearningAssessment must include elm:grade."@en ;
    ] ;
    sh:property [
        sh:path     elm:awardedBy ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message  "LearningAssessment must include elm:awardedBy."@en ;
    ] .

# =============================================================================
