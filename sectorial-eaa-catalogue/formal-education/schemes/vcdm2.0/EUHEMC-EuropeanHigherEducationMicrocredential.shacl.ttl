# =============================================================================
# SHACL Shape: European Higher Education Microcredential
# Profile:     EuropeanHigherEducationMicrocredential
# Version:     1.0.0
# Date:        2026-03-01
# Base schema: https://api-pilot.ebsi.eu/trusted-schemas-registry/v3/schemas/
#              0x05332a9dc53a4a26a15711262904f2a1dd081cf3da735350f42dac20426530a4
# EDC AP ref:  https://europa.eu/europass/elm-browser/documentation/rdf/ap/edc/
#              documentation/edc-generic-no-cv.html
# Licence:     CC BY 4.0
# =============================================================================

@prefix sh:       <http://www.w3.org/ns/shacl#> .
@prefix elm:      <http://data.europa.eu/snb/model/elm/> .
@prefix cred:     <https://www.w3.org/2018/credentials#> .
@prefix dc:       <http://purl.org/dc/terms/> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix rov:      <http://www.w3.org/ns/regorg#> .
@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix he-micro: <https://api-pilot.ebsi.eu/trusted-schemas-registry/v3/shacl/he-micro#> .


# =============================================================================
# ROOT SHAPE
# Target: every elm:EuropeanDigitalCredential node in the graph.
# Validates: profile type declaration, dual credentialSchema, issuer,
#            credentialSubject.
# =============================================================================

he-micro:CredentialShape
    a sh:NodeShape ;
    sh:targetClass elm:EuropeanDigitalCredential ;
    sh:name "European Higher Education Microcredential – SHACL Profile"@en ;
    sh:description
        "Level-3 semantic constraints for EuropeanHigherEducationMicrocredential  credentials issued under ELM 3.2 / W3C-VC 2.0 / eIDAS 2.0.  Complements the JSON Schema registered at EBSI TSR  0x05332a9dc53a4a26a15711262904f2a1dd081cf3da735350f42dac20426530a4."@en ;

    # -- Profile type ---------------------------------------------------------
    sh:property [
        sh:path     rdf:type ;
        sh:hasValue elm:EuropeanHigherEducationMicrocredential ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message  "Credential must declare elm:EuropeanHigherEducationMicrocredential."@en ;
    ] ;

    # -- Dual credentialSchema ------------------------------------------------
    sh:property [
        sh:path     cred:credentialSchema ;
        sh:minCount 2 ;
        sh:severity sh:Violation ;
        sh:message
            "credentialSchema must contain at least two entries:  one of type JsonSchema and one of type ShaclValidator2017."@en ;
    ] ;

    # -- Issuer ---------------------------------------------------------------
    sh:property [
        sh:path     cred:issuer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node     he-micro:IssuerShape ;
        sh:severity sh:Violation ;
        sh:message  "Credential must have exactly one issuer conforming to IssuerShape."@en ;
    ] ;

    # -- Credential subject ---------------------------------------------------
    sh:property [
        sh:path     cred:credentialSubject ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node     he-micro:CredentialSubjectShape ;
        sh:severity sh:Violation ;
        sh:message
            "Credential must have exactly one credentialSubject  conforming to CredentialSubjectShape."@en ;
    ] .


# =============================================================================
# ISSUER SHAPE
# Enforces eIDAS 2.0 requirement: issuer must carry exactly one
# eidasLegalIdentifier with notation and spatial jurisdiction.
# =============================================================================

he-micro:IssuerShape
    a sh:NodeShape ;
    sh:property [
        sh:path     elm:eidasLegalIdentifier ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node     he-micro:LegalIdentifierShape ;
        sh:severity sh:Violation ;
        sh:message  "Issuer must have exactly one eidasLegalIdentifier."@en ;
    ] .

he-micro:LegalIdentifierShape
    a sh:NodeShape ;
    sh:property [
        sh:path     skos:notation ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation ;
        sh:message  "eidasLegalIdentifier must carry a skos:notation value."@en ;
    ] ;
    sh:property [
        sh:path     dc:spatial ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message
            "Jurisdiction (dc:spatial) must be an IRI,  preferably from the EU Publications Office country vocabulary."@en ;
    ] .


# =============================================================================
# CREDENTIAL SUBJECT SHAPE
# Person with mandatory date of birth and at least one learning achievement.
# =============================================================================

he-micro:CredentialSubjectShape
    a sh:NodeShape ;
    sh:property [
        sh:path     elm:dateOfBirth ;
        sh:minCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:severity sh:Violation ;
        sh:message  "credentialSubject must include elm:dateOfBirth."@en ;
    ] ;
    sh:property [
        sh:path     elm:hasClaim ;
        sh:minCount 1 ;
        sh:node     he-micro:LearningAchievementShape ;
        sh:severity sh:Violation ;
        sh:message  "credentialSubject must have at least one LearningAchievement."@en ;
    ] .


# =============================================================================
# LEARNING ACHIEVEMENT SHAPE
# Semantic core of the HE microcredential.
# Key differentiator vs diploma: provenBy is MANDATORY here.
# =============================================================================

he-micro:LearningAchievementShape
    a sh:NodeShape ;

    # -- RDF type -------------------------------------------------------------
    sh:property [
        sh:path     rdf:type ;
        sh:hasValue elm:LearningAchievement ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message  "hasClaim node must be of type elm:LearningAchievement."@en ;
    ] ;

    # -- specifiedBy ----------------------------------------------------------
    sh:property [
        sh:path     elm:specifiedBy ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node     he-micro:SpecificationShape ;
        sh:severity sh:Violation ;
        sh:message
            "LearningAchievement must be specified by exactly one  LearningAchievementSpecification (elm:specifiedBy)."@en ;
    ] ;

    # -- awardedBy ------------------------------------------------------------
    sh:property [
        sh:path     elm:awardedBy ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node     he-micro:AwardingProcessShape ;
        sh:severity sh:Violation ;
        sh:message  "LearningAchievement must have exactly one elm:awardedBy."@en ;
    ] ;

    # -- provenBy (MANDATORY in microcredentials) -----------------------------
    sh:property [
        sh:path     elm:provenBy ;
        sh:minCount 1 ;
        sh:node     he-micro:LearningAssessmentShape ;
        sh:severity sh:Violation ;
        sh:message
            "An HE microcredential must include at least one assessment  (elm:provenBy). This is the key differentiator from a diploma."@en ;
    ] ;

    # -- creditReceived (recommended ECTS) ------------------------------------
    sh:property [
        sh:path     elm:creditReceived ;
        sh:node     he-micro:ECTSCreditShape ;
        sh:severity sh:Warning ;
        sh:message  "Declared credits should follow the ECTS framework (1–15 points)."@en ;
    ] .


# =============================================================================
# SPECIFICATION SHAPE
# LearningAchievementSpecification with EQF level, education subject and mode
# as mandatory; credit points recommended.
# =============================================================================

he-micro:SpecificationShape
    a sh:NodeShape ;

    # -- EQF level ------------------------------------------------------------
    sh:property [
        sh:path     elm:EQFLevel ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node     he-micro:EQFConceptShape ;
        sh:severity sh:Violation ;
        sh:message  "Specification must declare exactly one elm:EQFLevel."@en ;
    ] ;

    # -- Education subject ----------------------------------------------------
    sh:property [
        sh:path     elm:educationSubject ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message  "Specification must include at least one elm:educationSubject."@en ;
    ] ;

    # -- Learning mode --------------------------------------------------------
    sh:property [
        sh:path     elm:mode ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message  "Specification must include at least one elm:mode."@en ;
    ] ;

    # -- Credit points (recommended) ------------------------------------------
    sh:property [
        sh:path     elm:creditPoint ;
        sh:minCount 1 ;
        sh:node     he-micro:ECTSCreditShape ;
        sh:severity sh:Warning ;
        sh:message
            "It is recommended to declare ECTS credit points on the specification  (elm:creditPoint)."@en ;
    ] .


# =============================================================================
# EQF CONCEPT SHAPE
# Validates that the EQF level carries a valid notation (1–8) and,
# as a best practice, references the Publications Office EQF vocabulary.
# =============================================================================

he-micro:EQFConceptShape
    a sh:NodeShape ;

    # -- IRI pattern (best practice) ------------------------------------------
    sh:nodeKind sh:IRI ;
    sh:pattern  "^http://data\\.europa\\.eu/snb/eqf/" ;
    sh:severity sh:Warning ;
    sh:message
        "EQF level should reference the EU Publications Office EQF vocabulary  (http://data.europa.eu/snb/eqf/)."@en ;

    # -- Notation value -------------------------------------------------------
    sh:property [
        sh:path     skos:notation ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern  "^[1-8]$" ;
        sh:severity sh:Violation ;
        sh:message  "EQF level notation must be a single digit between 1 and 8."@en ;
    ] .


# =============================================================================
# ECTS CREDIT SHAPE
# Validates ECTS framework declaration and point range (1–15).
# =============================================================================

he-micro:ECTSCreditShape
    a sh:NodeShape ;
    sh:property [
        sh:path     elm:framework ;
        sh:minCount 1 ;
        sh:node     he-micro:ECTSFrameworkShape ;
        sh:severity sh:Violation ;
        sh:message  "Credit framework must be ECTS."@en ;
    ] ;
    sh:property [
        sh:path     elm:point ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern  "^(1[0-5]|[1-9])$" ;
        sh:severity sh:Violation ;
        sh:message  "ECTS credit points must be a whole number between 1 and 15."@en ;
    ] .

he-micro:ECTSFrameworkShape
    a sh:NodeShape ;
    sh:property [
        sh:path     skos:notation ;
        sh:hasValue "ECTS" ;
        sh:severity sh:Violation ;
        sh:message  "elm:framework notation must be exactly 'ECTS'."@en ;
    ] .


# =============================================================================
# AWARDING PROCESS SHAPE
# Validates awardingBody, awardingDate and location.
# Note: awardingBody does NOT require eidasLegalIdentifier (unlike the issuer).
# =============================================================================

he-micro:AwardingProcessShape
    a sh:NodeShape ;
    sh:property [
        sh:path     elm:awardingBody ;
        sh:minCount 1 ;
        sh:node     he-micro:AwardingBodyShape ;
        sh:severity sh:Violation ;
        sh:message  "AwardingProcess must include at least one elm:awardingBody."@en ;
    ] ;
    sh:property [
        sh:path     elm:awardingDate ;
        sh:minCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:severity sh:Violation ;
        sh:message  "AwardingProcess must include elm:awardingDate."@en ;
    ] ;
    sh:property [
        sh:path     elm:location ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message  "AwardingProcess must include elm:location."@en ;
    ] .

he-micro:AwardingBodyShape
    a sh:NodeShape ;
    sh:property [
        sh:path     rov:legalName ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message
            "It is recommended to include the legal name of the awarding body  (rov:legalName)."@en ;
    ] .


# =============================================================================
# LEARNING ASSESSMENT SHAPE
# Validates that every assessment carries a grade and an awardedBy.
# =============================================================================

he-micro:LearningAssessmentShape
    a sh:NodeShape ;
    sh:property [
        sh:path     elm:grade ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message  "LearningAssessment must include elm:grade."@en ;
    ] ;
    sh:property [
        sh:path     elm:awardedBy ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message  "LearningAssessment must include elm:awardedBy."@en ;
    ] .

